<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AudioInput records from the microphone; the app module declares this too. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed for ConnectivityManager, at least -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      No <application> element: backup posture (android:allowBackup, android:dataExtractionRules)
      is owned by the app module's manifest, since a single boolean/resource attribute can only
      have one value in the merged manifest. Declaring allowBackup here as well risked a stale
      value silently overriding, or conflicting with, the app module's.
    -->

</manifest>
