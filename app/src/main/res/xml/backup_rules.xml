<?xml version="1.0" encoding="utf-8"?>
<!--
  The server list and the secrets (server passwords, access tokens, client certificates) share
  databases/mumble.db, and Auto Backup excludes whole files. Cloud backup gets nothing. A local
  device-to-device transfer carries everything, but the secrets are encrypted with an Android
  Keystore key that never leaves the device: on the new phone they read as absent, so users
  must export their certificate (Settings, password-protected) before moving.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- No exclusions. -->
    </device-transfer>
</data-extraction-rules>
