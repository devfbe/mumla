<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        android:defaultValue="voiceActivity"
        android:entries="@array/audioInputNames"
        android:entryValues="@array/audioInputValues"
        android:key="audioInputMethod"
        android:summary="@string/audioInputMethodSum"
        android:title="@string/audioInputMethod"
        app:iconSpaceReserved="false"/>

    <!-- Filled and saved by AudioSettingsFragment through Settings.preferredAudioDevice. -->
    <ListPreference
        android:key="audio_device"
        android:persistent="false"
        android:title="@string/audio_device"
        android:dialogTitle="@string/audio_device"
        app:iconSpaceReserved="false"/>

    <!-- android:defaultValue must equal Settings.DEFAULT_BLUETOOTH_SCO. -->
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="pref_bluetooth_sco"
        android:summary="@string/bluetoothScoSum"
        android:title="@string/bluetoothSco"
        app:iconSpaceReserved="false"/>

    <se.lublin.mumla.preference.SliderPreference
        android:title="@string/audioInputVolume"
        android:summary="@string/audioInputVolumeSum"
        android:key="inputVolume"
        app:max="200"
        android:defaultValue="100"
        app:valueFormat="@string/unitPercent"
        app:iconSpaceReserved="false"/>

    <ListPreference
        android:key="noise_suppression_method"
        android:defaultValue="rnnoise"
        android:entries="@array/noiseSuppressionNames"
        android:entryValues="@array/noiseSuppressionValues"
        android:title="@string/noiseSuppression"
        android:summary="@string/noiseSuppressionSum"
        app:iconSpaceReserved="false"/>

    <!-- Strong (RNNoise) only: its attenuation limit in dB; the last position is no limit. Must
         stay in lockstep with Settings.RNNOISE_LIMIT_*. -->
    <se.lublin.mumla.preference.SliderPreference
        android:key="rnnoise_attenuation_limit_db"
        android:defaultValue="18"
        app:min="6"
        app:max="42"
        app:valueStep="2"
        app:valueFormat="@string/rnnoise_strength_value"
        app:maxValueLabel="@string/rnnoise_strength_unlimited"
        android:title="@string/rnnoise_strength"
        android:summary="@string/rnnoise_strength_sum"
        app:iconSpaceReserved="false"/>

    <!-- Writes the default through Settings; enabled only while the strength differs from it. -->
    <Preference
        android:key="rnnoise_strength_reset"
        android:persistent="false"
        android:title="@string/rnnoise_strength_reset"
        app:iconSpaceReserved="false"/>

    <!-- Opens the talk-over test; takes the microphone and the speaker, so not while connected. -->
    <Preference
        android:key="double_talk_test"
        android:persistent="false"
        android:title="@string/double_talk_test"
        android:summary="@string/double_talk_test_sum"
        app:iconSpaceReserved="false"/>

    <PreferenceCategory android:title="@string/voiceActivitySettings"
        android:key="vad_settings"
        app:iconSpaceReserved="false">
        <ListPreference
            android:key="vad_mode"
            android:defaultValue="adaptive"
            android:entries="@array/vadModeNames"
            android:entryValues="@array/vadModeValues"
            android:title="@string/vadMode"
            android:summary="@string/vadModeSum"
            app:iconSpaceReserved="false"/>

        <!-- Opt-in: the test takes the microphone and may switch the device to communication mode. -->
        <SwitchPreferenceCompat
            android:key="audio_test_microphone"
            android:persistent="false"
            android:defaultValue="false"
            android:title="@string/audioTestMicrophone"
            android:summary="@string/audioTestMicrophoneSum"
            app:iconSpaceReserved="false"/>

        <se.lublin.mumla.preference.InputLevelMeterPreference
            android:key="input_level_meter"
            android:persistent="false"
            android:title="@string/inputLevelMeter"
            android:summary="@string/inputLevelMeterSum"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="audio_loopback_test"
            android:dependency="audio_test_microphone"
            android:persistent="false"
            android:defaultValue="false"
            android:title="@string/audioLoopbackTest"
            android:summary="@string/audioLoopbackTestSum"
            app:iconSpaceReserved="false"/>

        <!-- Adaptive mode: a fraction of the measured speech-to-floor gap, not a loudness. -->
        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="65"
            android:key="vad_sensitivity"
            app:min="0"
            app:max="100"
            app:valueFormat="@string/unitPercent"
            android:summary="@string/vadSensitivitySum"
            android:title="@string/vadSensitivity"
            app:iconSpaceReserved="false"/>

        <!-- Classic mode: the legacy level slider, left on disk so switching back restores it. -->
        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="50"
            android:key="vadThreshold"
            app:max="100"
            app:valueFormat="@string/unitPercent"
            android:summary="@string/detectionThresholdSum"
            android:title="@string/detectionThreshold"
            app:iconSpaceReserved="false"/>

        <!-- Speech-model mode. -->
        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="60"
            android:key="vad_start"
            app:max="100"
            app:valueFormat="@string/unitPercent"
            android:summary="@string/vadStartSum"
            android:title="@string/vadStart"
            app:iconSpaceReserved="false"/>

        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="30"
            android:key="vad_stop"
            app:max="100"
            app:valueFormat="@string/unitPercent"
            android:summary="@string/vadStopSum"
            android:title="@string/vadStop"
            app:iconSpaceReserved="false"/>

        <Preference
            android:key="vad_recalibrate"
            android:persistent="false"
            android:title="@string/vadRecalibrate"
            android:summary="@string/vadRecalibrateSum"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <!-- Expert settings, collapsed behind one "Advanced" row. Kept on this screen so a running
         microphone test hears every change. -->
    <PreferenceCategory
        android:key="advanced_audio"
        app:initialExpandedChildrenCount="0"
        app:iconSpaceReserved="false">

        <!-- TODO add an actual min of 8000hz -->
        <ListPreference
            android:key="input_quality"
            android:defaultValue="48000"
            android:title="@string/audioSampleRate"
            android:summary="@string/audioSampleRateSum"
            android:entries="@array/audioSampleRateValues"
            android:entryValues="@array/audioSampleRateValues"
            app:iconSpaceReserved="false"/>

        <se.lublin.mumla.preference.SliderPreference
            android:key="input_bitrate"
            android:title="@string/inputQuality"
            android:summary="@string/inputQualitySum"
            app:min="8000"
            app:max="96000"
            app:valueStep="1000"
            android:defaultValue="40000"
            app:valueFormat="@string/unitKilobitsPerSecond"
            app:valueDivisor="1000"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="audio_per_packet"
            android:title="@string/audio_per_packet"
            android:summary="@string/audio_per_packet_sum"
            android:defaultValue="2"
            android:entryValues="@array/audio_per_packet_values"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="speex_noise_suppress_db"
            android:defaultValue="-25"
            android:entries="@array/speexNoiseSuppressNames"
            android:entryValues="@array/speexNoiseSuppressValues"
            android:title="@string/speexNoiseSuppress"
            android:summary="@string/speexNoiseSuppressSum"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="android_noise_suppressor"
            android:defaultValue="false"
            android:title="@string/androidNoiseSuppressor"
            android:summary="@string/androidNoiseSuppressorSum"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="android_agc"
            android:defaultValue="false"
            android:title="@string/androidAgc"
            android:summary="@string/androidAgcSum"
            app:iconSpaceReserved="false"/>

        <!-- The voice detector's tuning; like the section above, only used with voice activity. -->
        <SwitchPreferenceCompat
            android:key="vad_adaptive_floor"
            android:defaultValue="true"
            android:title="@string/vadAdaptiveFloor"
            android:summary="@string/vadAdaptiveFloorSum"
            app:iconSpaceReserved="false"/>

        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="45"
            android:key="vad_floor_db"
            app:min="20"
            app:max="90"
            app:valueFormat="@string/unitDbfsBelow"
            android:summary="@string/vadFloorSum"
            android:title="@string/vadFloor"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="vad_onset_frames"
            android:defaultValue="2"
            android:entries="@array/vadOnsetNames"
            android:entryValues="@array/vadOnsetValues"
            android:title="@string/vadOnset"
            android:summary="@string/vadOnsetSum"
            app:iconSpaceReserved="false"/>

        <se.lublin.mumla.preference.SliderPreference
            android:defaultValue="250"
            android:key="vad_hold_ms"
            app:min="0"
            app:max="2000"
            app:valueStep="10"
            app:valueFormat="@string/unitMilliseconds"
            android:summary="@string/vadHoldSum"
            android:title="@string/vadHold"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>
