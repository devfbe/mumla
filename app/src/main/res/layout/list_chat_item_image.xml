<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/chat_item_spacing"
    style="?cardStyle">

    <LinearLayout
        android:id="@+id/list_chat_item_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_small">

        <TextView
            android:id="@+id/list_chat_item_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="11sp"
            android:textColor="#999"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/list_chat_item_text_before"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/list_chat_item_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/chat_thumbnail_max"
            android:maxHeight="@dimen/chat_thumbnail_max"
            android:adjustViewBounds="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/chat_image_open"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/list_chat_item_image_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#999"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/list_chat_item_text_after"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/list_chat_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="11sp"
            android:textColor="#999" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
