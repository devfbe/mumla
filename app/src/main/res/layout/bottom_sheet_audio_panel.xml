<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/audio_panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_panel"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/audio_panel_devices_label"
            style="@style/AudioPanelLabel"
            android:labelFor="@id/audio_panel_devices"
            android:text="@string/audio_device" />

        <RadioGroup
            android:id="@+id/audio_panel_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/audio_panel_echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/echo_cancellation"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/audio_panel_transmit_label"
            style="@style/AudioPanelLabel"
            android:labelFor="@id/audio_panel_transmit"
            android:text="@string/audioInputMethod" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/audio_panel_transmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_transmit_voice"
                style="@style/AudioPanelSegment"
                android:text="@string/inputMethodVoice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_transmit_ptt"
                style="@style/AudioPanelSegment"
                android:text="@string/inputMethodPtt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_transmit_continuous"
                style="@style/AudioPanelSegment"
                android:text="@string/inputMethodContinuous" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/audio_panel_noise_label"
            style="@style/AudioPanelLabel"
            android:labelFor="@id/audio_panel_noise"
            android:text="@string/noiseSuppression" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/audio_panel_noise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_noise_none"
                style="@style/AudioPanelSegment"
                android:text="@string/noiseSuppressionNone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_noise_speex"
                style="@style/AudioPanelSegment"
                android:text="@string/noiseSuppressionLight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_noise_rnnoise"
                style="@style/AudioPanelSegment"
                android:text="@string/noiseSuppressionStrong" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/audio_panel_mic_label"
            style="@style/AudioPanelLabel"
            android:text="@string/mic_check" />

        <TextView
            android:id="@+id/audio_panel_mic_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <se.lublin.mumla.preference.LevelMeterView
            android:id="@+id/audio_panel_meter"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/inputLevelMeter"
            android:focusable="true" />

        <TextView
            android:id="@+id/audio_panel_transmit_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/audio_panel_meter_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Opens the talk-over test: a test voice on the speaker to talk over. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_double_talk"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/double_talk_test_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audio_panel_mic_toggle"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mic_check_start" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
