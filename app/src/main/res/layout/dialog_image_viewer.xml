<?xml version="1.0" encoding="utf-8"?>
<!--
    The image view needs its android:id (zoom state is saved per id) and must only ever hold the
    real image: a placeholder with an intrinsic size would consume the restored zoom. Hence the
    spinner and error text are siblings. No android:background: the theme already paints the
    window black, and a second full-screen fill is overdraw.
    The buttons draw one set of 24dp Material glyphs, padded to a 48dp touch target.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <se.lublin.mumla.chat.ZoomImageView
        android:id="@+id/image_viewer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/chat_image_viewer_image" />

    <ProgressBar
        android:id="@+id/image_viewer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/image_viewer_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/image_viewer_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/image_viewer_save"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_image_save"
            android:tooltipText="@string/chat_image_save"
            android:src="@drawable/ic_download"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/image_viewer_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_image_share"
            android:tooltipText="@string/chat_image_share"
            android:src="@drawable/ic_share"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/image_viewer_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_image_close"
            android:tooltipText="@string/chat_image_close"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
