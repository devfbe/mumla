<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/double_talk_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/double_talk_test"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/double_talk_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/double_talk_echo_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/double_talk_no_echo_cancellation"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <View
            android:id="@+id/double_talk_lamp"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/talk_lamp"
            android:contentDescription="@string/double_talk_lamp"
            android:focusable="true" />

        <TextView
            android:id="@+id/double_talk_lamp_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <se.lublin.mumla.preference.LevelMeterView
            android:id="@+id/double_talk_meter"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/inputLevelMeter"
            android:focusable="true" />

        <TextView
            android:id="@+id/double_talk_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/double_talk_false_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/double_talk_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/double_talk_method"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/double_talk_strength_label"
            style="@style/AudioPanelLabel"
            android:labelFor="@id/double_talk_strength"
            android:text="@string/rnnoise_strength" />

        <LinearLayout
            android:id="@+id/double_talk_strength_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.slider.Slider
                android:id="@+id/double_talk_strength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/rnnoise_strength" />

            <TextView
                android:id="@+id/double_talk_strength_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:gravity="end"
                android:importantForAccessibility="no"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <TextView
            android:id="@+id/double_talk_strength_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rnnoise_strength_sum"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/double_talk_strength_reset"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/rnnoise_strength_reset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/double_talk_retry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/double_talk_retry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/double_talk_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/double_talk_start" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
