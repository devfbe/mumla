<!-- Here be constants. These resources do NOT need translation. -->
<resources>
    <string-array
        name="audioInputNames">
        <item>@string/inputMethodVoice</item>
        <item>@string/inputMethodPtt</item>
        <item>@string/inputMethodContinuous</item>
    </string-array>

    <string-array
        name="audioInputValues">
        <item>voiceActivity</item>
        <item>ptt</item>
        <item>continuous</item>
    </string-array>

    <string-array
        name="audioSampleRateValues">
        <!-- Experimental -->
        <!--<item>128000</item>-->
        <!--<item>96000</item>-->
        <!--<item>72000</item>-->
        <!-- Likely supported -->
        <item>48000</item>
        <item>44100</item>
        <item>16000</item>
        <item>8000</item>
    </string-array>

    <string-array name="themeNames">
        <item>@string/theme_system</item>
        <item>@string/theme_light</item>
        <item>@string/theme_dark</item>
    </string-array>

    <string-array name="themeValues">
        <item>system</item>
        <item>forceLight</item>
        <item>forceDark</item>
    </string-array>

    <string-array name="hotCornerNames">
        <item>@string/hot_corner_none</item>
        <item>@string/hot_corner_top_left</item>
        <item>@string/hot_corner_bottom_left</item>
        <item>@string/hot_corner_top_right</item>
        <item>@string/hot_corner_bottom_right</item>
    </string-array>

    <string-array name="hotCornerValues">
        <item>none</item>
        <item>topLeft</item>
        <item>bottomLeft</item>
        <item>topRight</item>
        <item>bottomRight</item>
    </string-array>

    <string-array name="audio_per_packet_names">
        <item>10ms</item>
        <item>20ms</item>
        <item>40ms</item>
        <item>60ms</item>
    </string-array>

    <string-array name="audio_per_packet_values">
        <item>1</item>
        <item>2</item>
        <item>4</item>
        <item>6</item>
    </string-array>

    <string-array name="echoCancellationNames">
        <item>@string/echoCancellationDisabled</item>
        <item>@string/echoCancellationSystem</item>
        <item>WebRTC (AEC3)</item>
    </string-array>

    <string-array name="echoCancellationValues">
        <item>none</item>
        <item>system</item>
        <item>webrtc</item>
    </string-array>

    <string-array name="noiseSuppressionNames">
        <item>@string/noiseSuppressionNone</item>
        <item>@string/noiseSuppressionLight</item>
        <item>@string/noiseSuppressionStrong</item>
    </string-array>

    <!-- Must stay in lockstep with NoiseSuppressionMode.preferenceValue. -->
    <string-array name="noiseSuppressionValues">
        <item>none</item>
        <item>speex</item>
        <item>rnnoise</item>
    </string-array>

    <string-array name="speexNoiseSuppressNames">
        <item>@string/speexNoiseSuppressLow</item>
        <item>@string/speexNoiseSuppressMedium</item>
        <item>@string/speexNoiseSuppressHigh</item>
    </string-array>

    <!-- Must stay in lockstep with SpeexPreprocessor.SUPPORTED_NOISE_SUPPRESS_DB. -->
    <string-array name="speexNoiseSuppressValues">
        <item>-15</item>
        <item>-25</item>
        <item>-35</item>
    </string-array>

    <string-array name="vadModeNames">
        <item>@string/vadModeAdaptive</item>
        <item>@string/vadModeAmplitude</item>
        <item>@string/vadModeProbability</item>
    </string-array>

    <!-- Must stay in lockstep with VadMode.preferenceValue. -->
    <string-array name="vadModeValues">
        <item>adaptive</item>
        <item>amplitude</item>
        <item>probability</item>
    </string-array>

    <string-array name="vadOnsetNames">
        <item>@string/vadOnsetOff</item>
        <item>@string/vadOnset2</item>
        <item>@string/vadOnset3</item>
        <item>@string/vadOnset4</item>
    </string-array>

    <!-- Frames of 10 ms; 1 is "open on the first frame", i.e. the behaviour before this version. -->
    <string-array name="vadOnsetValues">
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>

    <string-array name="mediaButtonActionNames">
        <item>@string/mediaButtonActionNone</item>
        <item>@string/mediaButtonActionAuto</item>
        <item>@string/mediaButtonActionMute</item>
    </string-array>

    <!-- Must stay in lockstep with MediaButtonAction.prefValue; pinned by
         MediaButtonActionResourcesTest. -->
    <string-array name="mediaButtonActionValues">
        <item>none</item>
        <item>auto</item>
        <item>mute</item>
    </string-array>

